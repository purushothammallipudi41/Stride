# Stride Production Environment Variables Template
# Copy this to .env (or set these in Render Dashboard)

# Backend URL (Render will provide this for the frontend)
VITE_API_URL=https://stride-backend.onrender.com

# Persistence
# Use a real MongoDB Atlas URI for production!
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/stride?retryWrites=true&w=majority

# Professional Mailer (e.g., Resend, SendGrid, or Gmail App Password)
EMAIL_USER=contact@thestrideapp.in
EMAIL_PASS=your-app-specific-password
# Optional: SMTP Host (defaults to Gmail in server/index.cjs)
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
